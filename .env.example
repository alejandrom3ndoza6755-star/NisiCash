# Variables de entorno para NisiCash (Vercel)
# Copia este archivo como .env.local para desarrollo local
# En producción, configura estas variables en: Vercel Dashboard → Project → Settings → Environment Variables

# =============================================
# Upstash Redis (generadas automáticamente al conectar en Vercel Storage)
# =============================================
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=...
# KV_REST_API_READ_ONLY_TOKEN=...
# KV_URL=rediss://...
# REDIS_URL=rediss://...

# =============================================
# Seguridad interna (OBLIGATORIO en producción)
# =============================================
# Token compartido entre postbacks y record-survey.
# Genera uno con: openssl rand -hex 32
# Si no se define, /api/record-survey rechaza TODOS los requests (fail-closed).
INTERNAL_RECORD_TOKEN=cambia_esto_por_un_secreto_seguro

# =============================================
# CPX Research
# =============================================
# Tu Secure Hash Key de CPX Research
# Encuéntrala en: https://panel.cpx-research.com → App Settings → Security
CPX_SECURE_HASH_KEY=CNyYOocHuRrNRRqsUueyBCOQ9ZtzaHFN

# =============================================
# Wannads
# =============================================
# Credenciales de Wannads (usadas en el postback del servidor)
WANNADS_API_SECRET=981a7c7380

# =============================================
# Google Analytics (opcional)
# =============================================
# Tu Measurement ID de GA4
# Encuéntralo en: https://analytics.google.com → Admin → Data Streams
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================
# Facebook Pixel (opcional)
# =============================================
# Tu Pixel ID
# Encuéntralo en: https://business.facebook.com → Events Manager
# FB_PIXEL_ID=XXXXXXXXXX
